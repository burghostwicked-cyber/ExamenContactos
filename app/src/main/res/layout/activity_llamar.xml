<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF" android:padding="18dp">
    <Button android:id="@+id/btnRegresar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Atrás" android:textAllCaps="false"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/tvNombreLlamada" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#193650" android:gravity="center"/>
        <TextView android:id="@+id/tvNumeroLlamada" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="24sp"
            android:textColor="#263E51" android:gravity="center" android:layout_marginTop="14dp"/>
        <Button android:id="@+id/btnLlamar" android:layout_width="180dp"
            android:layout_height="62dp" android:layout_marginTop="80dp"
            android:background="@drawable/bg_green" android:text="📞 LLAMAR"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
